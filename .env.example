# Copy this file to .env and fill in real values. .env is gitignored —
# it never gets committed or published. In GitHub Actions, these same
# names are set as repository secrets instead (see README.md Phase 5).

# Your Resend API key (resend.com -> API Keys). Used to send the weekly
# email and deadline reminder.
RESEND_API_KEY=

# Where the weekly email and reminder should be sent. Kept out of
# config.yaml on purpose because config.yaml is committed to a public
# GitHub repo, and this address shouldn't be.
RECIPIENT_EMAIL=ssk3333@proton.me
